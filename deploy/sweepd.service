[Unit]
Description=SAdiy sweep daemon
After=network.target sadiy-pinmux.service
Wants=sadiy-pinmux.service

[Service]
# --bench-only until build_hw_engine exists: without it sweepd exits at once on hardware.
# It touches no pin until a client opens bench mode. Remove the flag when sweeps work on hardware.
# No User= on purpose: runs as root, the simple way to reach GPIO, SPI, I2C and config-pin.
ExecStart=/usr/bin/python3 -m sadiy.server.sweepd --bench-only --rt --config /etc/sadiy/local.toml
Environment=PYTHONPATH=/opt/sadiy/src
Restart=on-failure
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10

[Install]
WantedBy=multi-user.target
